# ============================================================
# likedsorter: credenciais do Spotify
#
# Como usar:
#   1. Copie este arquivo para ".env" (na pasta onde você roda o
#      comando) OU para o diretório de config do usuário:
#        Windows: %APPDATA%\likedsorter\.env
#        Linux:   ~/.config/likedsorter/.env
#        macOS:   ~/Library/Application Support/likedsorter/.env
#   2. Preencha o SPOTIFY_CLIENT_ID abaixo.
#   3. Rode: likedsorter auth login
#
# O ".env" é ignorado pelo git. NUNCA versione credenciais.
# Variáveis de ambiente reais têm precedência sobre este arquivo.
# ============================================================

# Client ID do app criado em https://developer.spotify.com/dashboard
# (PKCE não usa Client Secret: não precisa preencher nenhum segredo)
SPOTIFY_CLIENT_ID=COLE_SEU_CLIENT_ID_AQUI

# Deve ser IDÊNTICO ao Redirect URI cadastrado no Dashboard.
# O Spotify não aceita "localhost": use 127.0.0.1 com porta.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ------------------------------------------------------------
# Opcionais: fontes extras de gênero (Fase 4)
# ------------------------------------------------------------
# Last.fm (https://www.last.fm/api/account/create). Só uso NÃO comercial.
# Necessário apenas se usar --genre-source=...,lastfm
LASTFM_API_KEY=

# Discogs (https://www.discogs.com/settings/developers -> Generate new token).
# Necessário apenas se usar --genre-source=...,discogs
# (Deezer não precisa de chave: --genre-source=...,deezer)
DISCOGS_TOKEN=

# Contato enviado no User-Agent do MusicBrainz (exigência deles):
# uma URL ou e-mail seu. Ex.: https://github.com/seu-usuario/likedsorter
LIKEDSORTER_CONTACT=
